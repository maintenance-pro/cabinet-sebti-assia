{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      ".git/**",
      ".vscode/**",
      ".firebase/**",
      "**/node_modules/**",
      "desktop.ini",
      "README.md",
      "exemple-cabinet-sebti-assia.json"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Cabinet Sebti Assia",
        "supportEmail": "bilalnahil05@gmail.com",
        "authorizedRedirectUris": [
          "https://cabinet-sebti-assia.web.app/__/auth/handler",
          "https://cabinet-sebti-assia.firebaseapp.com/__/auth/handler"
        ]
      }
    }
  }
}
